{
  "name": "ferrogate",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "FerroGate AI Gateway — TypeScript on Cloudflare Workers (Bun + Hono + Zod + Wrangler).",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter '*' build",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "hono": "^4.6.0",
    "zod": "^3.25.76",
    "@hono/zod-validator": "^0.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "typescript": "5.5.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
