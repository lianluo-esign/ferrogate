{
  "id": "money/token-budget-exhausted",
  "schema": 1,
  "description": "A key whose monthly token budget is zero is refused admission before any provider spend is estimated; the budget is enforced at authentication, not at settlement.",
  "world": {
    "config": {
      "providers": [
        {
          "name": "primary",
          "kind": "openai-compatible",
          "base_url": "https://provider.invalid/v1",
          "region": "us-east-1"
        }
      ],
      "models": [
        {
          "name": "fast-chat",
          "provider": "primary",
          "provider_model": "gpt-4o-mini"
        }
      ],
      "api_keys": [
        {
          "id": "key-1",
          "name": "conformance key",
          "key": "secret-1",
          "scopes": [
            "chat.completions",
            "responses.create"
          ],
          "organization_id": "tenant-1",
          "project_id": "project-1",
          "monthly_token_budget": 0
        }
      ]
    }
  },
  "request": {
    "endpoint": "chat.completions",
    "headers": {
      "authorization": "Bearer secret-1"
    },
    "now_unix": 1784937600,
    "body": {
      "model": "fast-chat",
      "messages": [
        {
          "role": "user",
          "content": "hello"
        }
      ]
    }
  },
  "expect": {
    "schema": 1,
    "outcome": "deny",
    "status": 429,
    "code": "token_budget_exceeded",
    "durable_writes": [
      "request_log"
    ],
    "audit_events": []
  },
  "worker_shell": {
    "deny_list": [],
    "expect": {
      "schema": 1,
      "outcome": "defer",
      "status": 0
    }
  }
}
