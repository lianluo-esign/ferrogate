{
  "id": "model/not-allowed-for-key",
  "schema": 1,
  "description": "A key's model allowlist is enforced before the model registry is consulted, so an unlisted model is 403 rather than a 400 about an unknown model.",
  "world": {
    "config": {
      "providers": [
        {
          "name": "primary",
          "kind": "openai-compatible",
          "base_url": "https://provider.invalid/v1",
          "region": "us-east-1"
        }
      ],
      "models": [
        {
          "name": "fast-chat",
          "provider": "primary",
          "provider_model": "gpt-4o-mini"
        }
      ],
      "api_keys": [
        {
          "id": "key-1",
          "name": "conformance key",
          "key": "secret-1",
          "scopes": [
            "chat.completions",
            "responses.create"
          ],
          "organization_id": "tenant-1",
          "project_id": "project-1",
          "allowed_models": [
            "other-model"
          ]
        }
      ]
    }
  },
  "request": {
    "endpoint": "chat.completions",
    "headers": {
      "authorization": "Bearer secret-1"
    },
    "now_unix": 1784937600,
    "body": {
      "model": "fast-chat",
      "messages": [
        {
          "role": "user",
          "content": "hello"
        }
      ]
    }
  },
  "expect": {
    "schema": 1,
    "outcome": "deny",
    "status": 403,
    "code": "model_not_allowed",
    "durable_writes": [
      "request_log"
    ],
    "audit_events": []
  },
  "worker_shell": {
    "deny_list": [],
    "expect": {
      "schema": 1,
      "outcome": "defer",
      "status": 0
    }
  }
}
