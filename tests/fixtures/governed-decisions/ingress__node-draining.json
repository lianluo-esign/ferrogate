{
  "id": "ingress/node-draining",
  "schema": 1,
  "description": "A draining node refuses new AI work with 503 after authenticating, so the caller can retry elsewhere and the drain is observable per request.",
  "world": {
    "config": {
      "providers": [
        {
          "name": "primary",
          "kind": "openai-compatible",
          "base_url": "https://provider.invalid/v1",
          "region": "us-east-1"
        }
      ],
      "models": [
        {
          "name": "fast-chat",
          "provider": "primary",
          "provider_model": "gpt-4o-mini"
        }
      ],
      "api_keys": [
        {
          "id": "key-1",
          "name": "conformance key",
          "key": "secret-1",
          "scopes": ["chat.completions", "responses.create"],
          "organization_id": "tenant-1",
          "project_id": "project-1"
        }
      ]
    },
    "draining": true
  },
  "request": {
    "endpoint": "chat.completions",
    "headers": {
      "authorization": "Bearer secret-1"
    },
    "now_unix": 1784937600,
    "body": {
      "model": "fast-chat",
      "messages": [
        {
          "role": "user",
          "content": "hello"
        }
      ]
    }
  },
  "expect": {
    "schema": 1,
    "outcome": "deny",
    "status": 503,
    "code": "node_draining",
    "durable_writes": ["request_log"],
    "audit_events": []
  },
  "worker_shell": {
    "deny_list": [],
    "expect": {
      "schema": 1,
      "outcome": "defer",
      "status": 0
    }
  }
}
