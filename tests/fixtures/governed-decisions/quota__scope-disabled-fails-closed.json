{
  "id": "quota/scope-disabled-fails-closed",
  "schema": 1,
  "description": "A disabled quota policy anywhere in the org/project/workspace/key chain is a hard deny, not a fallback to the plan default.",
  "world": {
    "config": {
      "providers": [
        {
          "name": "primary",
          "kind": "openai-compatible",
          "base_url": "https://provider.invalid/v1",
          "region": "us-east-1"
        }
      ],
      "models": [
        {
          "name": "fast-chat",
          "provider": "primary",
          "provider_model": "gpt-4o-mini"
        }
      ],
      "api_keys": [
        {
          "id": "key-1",
          "name": "conformance key",
          "key": "secret-1",
          "scopes": ["chat.completions", "responses.create"],
          "organization_id": "tenant-1",
          "project_id": "project-1"
        }
      ]
    },
    "quota_policies": [
      {
        "id": "tenant:tenant-1",
        "scope_type": "tenant",
        "scope_id": "tenant-1",
        "enabled": false
      }
    ]
  },
  "request": {
    "endpoint": "chat.completions",
    "headers": {
      "authorization": "Bearer secret-1"
    },
    "now_unix": 1784937600,
    "body": {
      "model": "fast-chat",
      "messages": [
        {
          "role": "user",
          "content": "hello"
        }
      ]
    }
  },
  "expect": {
    "schema": 1,
    "outcome": "deny",
    "status": 403,
    "code": "quota_scope_disabled",
    "durable_writes": ["request_log"],
    "audit_events": []
  },
  "worker_shell": {
    "deny_list": [],
    "expect": {
      "schema": 1,
      "outcome": "defer",
      "status": 0
    }
  }
}
