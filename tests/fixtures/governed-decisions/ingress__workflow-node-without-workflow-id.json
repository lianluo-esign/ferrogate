{
  "id": "ingress/workflow-node-without-workflow-id",
  "schema": 1,
  "description": "Workflow version/node/iteration headers require a workflow id: the coherence rule is enforced at ingress so a half-specified workflow can never reach policy.",
  "world": {
    "config": {
      "providers": [
        {
          "name": "primary",
          "kind": "openai-compatible",
          "base_url": "https://provider.invalid/v1",
          "region": "us-east-1"
        }
      ],
      "models": [
        {
          "name": "fast-chat",
          "provider": "primary",
          "provider_model": "gpt-4o-mini"
        }
      ],
      "api_keys": [
        {
          "id": "key-1",
          "name": "conformance key",
          "key": "secret-1",
          "scopes": ["chat.completions", "responses.create"],
          "organization_id": "tenant-1",
          "project_id": "project-1"
        }
      ]
    }
  },
  "request": {
    "endpoint": "chat.completions",
    "headers": {
      "authorization": "Bearer secret-1",
      "x-ferrogate-workflow-node-id": "node-1"
    },
    "now_unix": 1784937600,
    "body": {
      "model": "fast-chat",
      "messages": [
        {
          "role": "user",
          "content": "hello"
        }
      ]
    }
  },
  "expect": {
    "schema": 1,
    "outcome": "deny",
    "status": 400,
    "code": "invalid_workflow_header",
    "durable_writes": ["request_log"],
    "audit_events": []
  },
  "worker_shell": {
    "deny_list": [],
    "expect": {
      "schema": 1,
      "outcome": "defer",
      "status": 0
    }
  }
}
